// Writes docs/sandbox-validation.md: every PayPal REST endpoint the app has called in the sandbox, from our own call
// log (paypal_calls: every request with its status, PayPal-Request-Id and PayPal-Debug-Id), with the acceptance tests
// that exercise it. Debug ids are PayPal's own references; PayPal support can look any of them up.
// Usage: pnpm --filter web sandbox-validation
import { writeFileSync } from "node:fs";
import { resolve } from "node:path";
import pg from "pg";

const PROOF: Record<string, { what: string; ats: string }> = {
  "POST /v2/checkout/orders": { what: "Create an order from server-computed totals, per-seller payee, PayPal-Request-Id", ats: "phase1 gate, `shop-checks`, `approval-checks`, `cart-checks` K6, `gauntlet-checks` GA2 (naive orders)" },
  "GET /v2/checkout/orders/{id}": { what: "Fallback checks, return-URL checks, Cart API checkout, reconciliation", ats: "`phase2-checks`, `recovery-checks`, `cart-checks`, `reconcile-checks`, `gauntlet-checks` GA2" },
  "POST /v2/checkout/orders/{id}/capture": { what: "Capture after the buyer approves (intent CAPTURE)", ats: "phase1 gate, `shop-checks`, `approval-checks`, `telegram-flow-checks` F3" },
  "POST /v2/checkout/orders/{id}/authorize": { what: "Cart API: authorize at checkout (D-098)", ats: "`cart-checks` K6, K7, K9" },
  "POST /v2/payments/authorizations/{id}/capture": { what: "Cart API: capture on ship", ats: "`cart-checks` K8, K9" },
  "POST /v2/payments/authorizations/{id}/void": { what: "Cart API: void a hold before shipping", ats: "`cart-checks` K10" },
  "GET /v2/payments/captures/{id}": { what: "GET the capture before every refund; the capture's payee", ats: "`phase4-checks`, `cart-checks` K9, `reconcile-checks`" },
  "POST /v2/payments/captures/{id}/refund": { what: "Refunds decided by the policy engine or the seller's tap", ats: "`phase4-checks`, `telegram-flow-checks` F4, `reconcile-checks`" },
  "POST /v2/checkout/orders/{id}/track": { what: "Tracking from a label photo onto the PayPal order", ats: "`phase4-checks` #5, `telegram-flow-checks` F6" },
  "POST /v1/notifications/verify-webhook-signature": { what: "Every webhook verified with PayPal; forgeries rejected", ats: "`phase2-checks`, `hack-checks`, `gauntlet-checks` (replay-webhook)" },
  "GET /v1/reporting/transactions": { what: "[paypal] figures and reconciliation (Transaction Search)", ats: "`dashboard-checks` G4b, `ag-checks` A1, A4, `reconcile-checks`" },
  "POST /v1/catalogs/products": { what: "Listings mirrored into PayPal's catalog on publish", ats: "`studio-checks` E4, `telegram-flow-checks` F5" },
  "PATCH /v1/catalogs/products/{id}": { what: "Catalog write-back from the dashboard (description, category, image)", ats: "`dashboard-checks` G1" },
};

const db = new pg.Client({ connectionString: process.env.DATABASE_URL });
await db.connect();
const { rows } = await db.query<{ endpoint: string; n: number; first: string; last: string; statuses: string; ok_debug: string | null; err_debug: string | null; err_status: number | null }>(`
  with c as (
    select *, method || ' ' || regexp_replace(regexp_replace(split_part(path, '?', 1), '/[A-Z0-9]{12,}(-[A-Za-z0-9-]+)?', '/{id}', 'g'), '/prd_[a-z0-9]+', '/{id}', 'g') endpoint
    from paypal_calls)
  select endpoint, count(*)::int n, to_char(min(created_at) at time zone 'UTC', 'YYYY-MM-DD') first, to_char(max(created_at) at time zone 'UTC', 'YYYY-MM-DD') last,
    string_agg(distinct status::text, ', ' order by status::text) statuses,
    (select debug_id from c c2 where c2.endpoint = c.endpoint and c2.status < 300 and c2.debug_id is not null order by id desc limit 1) ok_debug,
    (select debug_id from c c2 where c2.endpoint = c.endpoint and c2.status >= 400 and c2.debug_id is not null order by id desc limit 1) err_debug,
    (select status from c c2 where c2.endpoint = c.endpoint and c2.status >= 400 order by id desc limit 1) err_status
  from c group by endpoint order by n desc`);
const total = rows.reduce((n, r) => n + r.n, 0);
await db.end();

const lines = [
  "# Sandbox validation",
  "",
  `Generated by \`pnpm --filter web sandbox-validation\` on ${new Date().toISOString().slice(0, 10)} from the app's own PayPal call log (\`paypal_calls\`). Every row is a real call to the PayPal sandbox (\`api-m.sandbox.paypal.com\`), made by the deployed app or by the acceptance suites against it. Nothing is mocked.`,
  "",
  `**${total.toLocaleString("en-US")} PayPal calls across ${rows.length} endpoints.** A debug id is PayPal's own reference for one call (\`PayPal-Debug-Id\`); PayPal can look up any of them. Error statuses are expected where a test checks a refusal (for example a $0.00 order, a declined capture via PayPal's negative-testing header, an invalid catalog PATCH).`,
  "",
  "| Endpoint | What we use it for | Calls | Statuses seen | First → last | Latest success (debug id) | Latest error (debug id) | Proved by |",
  "|---|---|---:|---|---|---|---|---|",
  ...rows.map((r) => {
    const p = PROOF[r.endpoint];
    return `| \`${r.endpoint}\` | ${p?.what ?? "—"} | ${r.n.toLocaleString("en-US")} | ${r.statuses} | ${r.first} → ${r.last} | ${r.ok_debug ? `\`${r.ok_debug}\`` : "—"} | ${r.err_debug ? `${r.err_status} \`${r.err_debug}\`` : "—"} | ${p?.ats ?? "—"} |`;
  }),
  "",
  "Not in the log (by design): the OAuth token call (cached, refreshed server-side, never logged with its secret), the JS SDK v6 approval in the buyer's browser (PayPal's own UI; proved by the approval tests above), and Log in with PayPal's identity calls (`connect-checks` C1–C7).",
  "",
  "The acceptance suites and their latest results are listed in the README (\"What's real (and verified)\"); each suite ends with a reconciliation against PayPal (D-095).",
  "",
];
writeFileSync(resolve("../../docs/sandbox-validation.md"), lines.join("\n"));
console.log(`wrote docs/sandbox-validation.md: ${rows.length} endpoints, ${total} calls`);
