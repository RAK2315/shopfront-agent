// Writes the README's test counts between <!-- test-counts:start --> and <!-- test-counts:end -->, so the numbers in
// the README always come from the code: unit tests from Vitest's own JSON report, acceptance checks from the ids each
// suite records (record("G4a …")). Usage: pnpm --filter web test-counts
import { execFileSync } from "node:child_process";
import { readdirSync, readFileSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join, resolve } from "node:path";

const root = resolve("../..");
const outFile = join(tmpdir(), `shopfront-vitest-${process.pid}.json`);
execFileSync(process.platform === "win32" ? "pnpm.cmd" : "pnpm", ["exec", "vitest", "run", "--reporter=json", `--outputFile=${outFile}`], { cwd: root, stdio: "ignore", shell: process.platform === "win32" });
const report = JSON.parse(readFileSync(outFile, "utf8")) as { numTotalTests: number; numPassedTests: number; testResults: Array<{ name: string; assertionResults: unknown[] }> };
const byPackage = new Map<string, number>();
for (const f of report.testResults) {
  const rel = f.name.replace(/\\/g, "/").split("/");
  const at = rel.findIndex((p) => p === "packages" || p === "apps");
  const pkg = at >= 0 ? `${rel[at]}/${rel[at + 1]}` : "other";
  byPackage.set(pkg, (byPackage.get(pkg) ?? 0) + f.assertionResults.length);
}

// Acceptance suites: the checks each suite lists in its header comment ("//   G4  …", ranges like "P1–P5").
// phase9-checks is superseded (D-093) and not counted.
const dir = resolve("scripts");
const SUPERSEDED = new Set(["phase9-checks"]);
const suites = readdirSync(dir)
  .filter((f) => /-checks\.mts$/.test(f) && !SUPERSEDED.has(f.replace(/\.mts$/, "")))
  .map((f) => {
    const src = readFileSync(join(dir, f), "utf8");
    const ids = new Set<string>();
    for (const m of src.matchAll(/^\/\/\s{2,}([A-Z]{0,3})(\d+)([a-z]?)(?:[–-][A-Z]{0,3}(\d+))?\s/gm)) {
      const [, p, a, sfx, b] = m;
      if (b) for (let i = Number(a); i <= Number(b); i++) ids.add(`${p}${i}`);
      else ids.add(`${p}${a}${sfx}`);
    }
    return { suite: f.replace(/\.mts$/, ""), checks: ids.size };
  })
  .filter((s) => s.checks > 0)
  .sort((a, b) => a.suite.localeCompare(b.suite));
const atTotal = suites.reduce((n, s) => n + s.checks, 0);

const block = [
  "<!-- test-counts:start -->",
  `**${report.numPassedTests}/${report.numTotalTests} unit tests pass** (${[...byPackage.entries()].map(([k, v]) => `${k} ${v}`).join(", ")}), and **${suites.length} acceptance suites with ${atTotal} checks** run against the deployed app with real PayPal sandbox calls: ${suites.map((s) => `\`${s.suite}\` ${s.checks}`).join(", ")}.`,
  "",
  `<sub>Generated by \`pnpm --filter web test-counts\` on ${new Date().toISOString().slice(0, 10)}. Per-call PayPal evidence: [docs/sandbox-validation.md](docs/sandbox-validation.md).</sub>`,
  "<!-- test-counts:end -->",
].join("\n");

const readmePath = join(root, "README.md");
const readme = readFileSync(readmePath, "utf8");
const re = /<!-- test-counts:start -->[\s\S]*?<!-- test-counts:end -->/;
if (!re.test(readme)) throw new Error("README.md has no test-counts markers");
const nl = readme.includes("\r\n") ? "\r\n" : "\n";
writeFileSync(readmePath, readme.replace(re, block.replace(/\r?\n/g, nl)));
console.log(block);
