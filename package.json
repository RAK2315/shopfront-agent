{
  "name": "shopfront-agent",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:policy-coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include=packages/core/src/refund-policy.ts --coverage.reporter=text-summary --coverage.thresholds.branches=100 packages/core/src/refund-policy.test.ts",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "pnpm --filter web lint",
    "paypal:toolkit-token": "node scripts/refresh-paypal-ai-toolkit-token.mjs",
    "safe-rm": "node scripts/safe-rm.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "5.0.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
