# ---------- PayPal (sandbox) ---------- docs/SETUP.md §1-3
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ---------- LLM (free tiers only) ---------- docs/SETUP.md §4-5, DECISIONS D-028/D-029
# LLM_MODE: live = call providers (cache first); replay = never call providers, use recorded transcripts
LLM_MODE=live
# D-038: Groq first for agent tool-calling + chat (fast); Gemini only for vision (latency hidden by the card animation)
LLM_AGENT_PROVIDERS=groq,gemini
LLM_VISION_PROVIDERS=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_STRONG=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_MAX_CALLS_PER_DAY=400
LLM_MAX_CALLS_PER_IP_PER_HOUR=30

# ---------- Database (Neon free) ---------- docs/SETUP.md §6
# Pooled URL (host contains -pooler) for the app; direct URL for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ---------- App ----------
APP_URL=http://localhost:3000
SESSION_SECRET=

# ---------- AG Studio trial (expires 2026-11-29) ---------- docs/SETUP.md §7
NEXT_PUBLIC_AG_LICENSE_KEY=

# ---------- Testing only (never shown in UI) ----------
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=
# Second US Personal sandbox buyer (AT-2 check F, D-040)
SANDBOX_BUYER2_EMAIL=
SANDBOX_BUYER2_PASSWORD=
DEV_ALLOW_UNVERIFIED_WEBHOOKS=false

# ---------- Deploy (local only, never in Render env) ----------
# Render dashboard → Account Settings → API Keys → Create API Key
RENDER_API_KEY=
